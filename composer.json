{
    "name": "devkussema/acapapay-laravel",
    "description": "SDK Oficial AcapaPay para integração rápida em aplicações Laravel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Augusto Kussema",
            "email": "dev.kussema@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0|^14.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0|^13.0|^14.0"
    },
    "autoload": {
        "psr-4": {
            "AcapaPay\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AcapaPay\\Laravel\\AcapaPayServiceProvider"
            ],
            "aliases": {
                "AcapaPay": "AcapaPay\\Laravel\\Facades\\AcapaPay"
            }
        }
    }
}
